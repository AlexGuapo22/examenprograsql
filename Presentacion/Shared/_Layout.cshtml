<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reparaciones</title>
    <link rel="stylesheet" href="~/css/Estilo.css" asp-append-version="true" />
</head>
<body>
    <ul>
        <li><a class="@(ViewData["Menu"] as string == "inicio" ? "active" : "")" href="/">Inicio</a></li>
        <li><a class="@(ViewData["Menu"] as string == "usuarios" ? "active" : "")" href="/CatalogoUsuarios">Usuarios</a></li>
        <li><a class="@(ViewData["Menu"] as string == "equipos" ? "active" : "")" href="/CatalogoEquipos">Equipos</a></li>
    </ul>
    <div class="contenido">
        @RenderBody()
    </div>
</body>
</html>
